{
  "name": "rainystatus-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "RainyStatus 云端：Cloudflare Worker（状态网页 + 心跳 API）",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:sql": "python3 scripts/d1check.py",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.143.0"
  }
}
