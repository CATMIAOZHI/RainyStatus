{
  // ═══════════════════════════════════════════════════════
  // RainyStatus 云端 Worker 配置（**模板**）
  //
  // 一键部署（Deploy to Cloudflare）会自动创建 KV namespace 并绑定，
  // 所以下面 kv_namespaces 里**刻意不写 id**：写成占位字符串的话，
  // wrangler 会认为「id 已指定」而跳过自动创建，最后把那个占位串当真实
  // namespace id 用（dry-run 查不出来，只有真实 deploy 才会失败）。
  //
  // 手动部署则要自己填：先 `npx wrangler kv namespace create STATUS_KV`
  // 再把输出的 id 填进来（README 手动部署一节有完整步骤）。
  // ═══════════════════════════════════════════════════════
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rainystatus",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",

  // 默认暴露 *.workers.dev 子域（人人可用，不依赖自有域名）。
  // 想绑定自己的域名，见本文件末尾注释与根目录 README.md 的部署章节。
  "workers_dev": true,

  // 静态资源（网页）—— Cloudflare 官方：static assets 请求免费且不限量。
  // 不设 run_worker_first（默认 false）→ 静态资源优先命中，
  // 因此即使免费额度耗尽（错误码 1027）网页仍能打开，只有 /api/* 报错。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "kv_namespaces": [
    {
      // 刻意留空 id：一键部署时 wrangler 会自动创建并绑定 KV
      // （实测：`npx wrangler deploy` 会输出 "STATUS_KV provisioned 🎉"）。
      // 手动部署请先 `npx wrangler kv namespace create STATUS_KV` 再把 id 填这里。
      "binding": "STATUS_KV"
    }
  ],

  // ── 站点可配置项：别人部署后改成自己的 ──
  "vars": {
    "SITE_TITLE": "RainyStatus",
    "OWNER_NAME": "RainyStatus",
    "AVATAR_EMOJI": "☔",
    // 头像图片：填了就用图片，没配或加载失败用上面的 AVATAR_EMOJI。
    // 三种写法都行：站内路径 "/avatar.png"（把图放进 cloud/public/）、
    // https 外链、或小尺寸 "data:image/png;base64,…"
    // 不要填 http:// （https 页面会把它当混合内容拦掉）。
    "AVATAR_URL": "",
    "OFFLINE_THRESHOLD_MS": "1800000",
    "NEXT_EXPECTED_MS": "600000",
    "SHOW_TEMPERATURE": "false",
    "SHOW_NETWORK": "false",
    "SHOW_MOOD": "true",
    "TIMEZONE_OFFSET_MINUTES": "auto",
    "DEFAULT_LANG": "zh-Hans",

    // 状态文案（可选）：留空则用内置三语文案、跟访客语言切换。
    // 填了就固定显示你写的这句，不跟语言切换。
    "STATUS_TEXT_ONLINE": "",
    "STATUS_TEXT_OFFLINE": "",
    "STATUS_TEXT_GONE": "",
    "STATUS_TEXT_NO_DATA": ""
  },

  // 不设 limits.cpu_ms：免费版上限就是 10ms，设更小会自杀、设更大无效
  "observability": {
    "enabled": true
  }

  // ── 历史图表（可选，默认全关）──
  // 想开启：先建库并执行迁移，再把下面的绑定与 cron 打开。
  //   npx wrangler d1 create rainystatus-history
  //   npx wrangler d1 execute rainystatus-history --remote --file=./migrations/0001_history.sql
  // 然后把 vars 里的 HISTORY_ENABLED 设为 "true"、HISTORY_RANGES 设为 "24h"。
  // 注意：D1 绑定**不写进模板**，因为写占位 id 会让 wrangler 跳过自动创建；
  // 而目前只有 KV 验证过「无 id 自动 provision」这条路。
  //
  // "d1_databases": [
  //   { "binding": "HISTORY_DB", "database_name": "rainystatus-history", "database_id": "<你的 id>" }
  // ],
  //
  // 图表接口需要人机验证时才配置 Turnstile（免费）：
  //   npx wrangler secret put TURNSTILE_SECRET
  // 并在 vars 里填 TURNSTILE_SITE_KEY。配了密钥就会强制校验。
  //
  // 定时任务只负责「预生成导出 + 清理过期数据」，聚合跟着心跳走，不在这里。
  // "triggers": {
  //   "crons": ["*/15 * * * *"]
  // }

  // ── 静态数据域（可选，默认关闭）：人多时把「读」搬出 Worker ──
  // 背景：`/api/status` 每个访客都要打一次 Worker，免费额度 10 万请求/天；
  // 而 R2 + 独立域 + CDN 缓存的读取**不经过 Worker**，免费且不限量。
  // 想开启（顺序不能反）：
  //   1. 控制台开通 R2（计费产品，可能需要绑定支付方式）
  //   2. 建桶并把自定义域接上，例如 data.example.com；**关闭 r2.dev 开发域**（它不走缓存规则与 WAF）
  //   3. ⚠️ **必须**加缓存规则：整域匹配 + 缓存所有内容 + Edge TTL 60s
  //      + 浏览器 TTL 60s（否则该 zone 的默认 Browser Cache TTL 会改写成几小时）
  //   4. 加 WAF 规则：只放行 `status.json` 这条路径、拦非 GET/HEAD 与带查询串的请求
  //      （免费版的 Cache Key 不支持「忽略查询串」，随机 `?x=` 会绕过缓存直打 R2）
  //   5. 开 Smart Tiered Cache，否则「每个边缘机房各自回源」也会把免费额度打穿
  //   6. vars 里补 "DATA_ENABLED": "true" 与 "DATA_BASE_URL": "https://data.example.com"，
  //      并启用下面的 r2_buckets 绑定；页面里可选加
  //      `<meta name="rainystatus-data-base" content="https://data.example.com">`
  // 详见 docs/security-and-quotas.md（开启清单 / 攻击面 / 熔断）与 docs/api.md 的「静态数据域」。
  //
  // "r2_buckets": [
  //   { "binding": "DATA_BUCKET", "bucket_name": "rainystatus-data" }
  // ],
  //
  // ── 配额熔断（可选，默认关闭）：R2 没有「用完停」，超限自动停用数据域（自定义域 + r2.dev）──
  // 需要一个新的 API token（Account Analytics:Read + Workers R2 Storage:Write）：
  //   npx wrangler secret put CF_GUARD_TOKEN
  // 再把下面这些填上（GUARD_ACCOUNT_ID 是你的 Cloudflare 账号 id）：
  //
  // "GUARD_ENABLED": "true",
  // "GUARD_MAX_MONTHLY": "6000000",   // 免费额度 1000 万/月的 60%
  // "GUARD_MAX_HOURLY": "2000000",
  // "GUARD_ACCOUNT_ID": "<账号 id>",
  // "GUARD_BUCKET_NAME": "rainystatus-data",
  // "GUARD_HOSTNAME": "data.example.com"

  // ── 绑定自有域名（可选）──
  // 前提：该域名所在 zone 在本账号且 active，且该主机名没有已存在的 CNAME。
  // Cloudflare 会自动创建 DNS 记录并签发证书（可能等 1–2 分钟）。
  // 配好后把上面的 "workers_dev": true 改成 false（收敛扫描面）：
  //
  // "routes": [
  //   { "pattern": "status.example.com", "custom_domain": true }
  // ]
}