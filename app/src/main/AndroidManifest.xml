<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络上报 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络类型判定与恢复检测 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务（常驻心跳） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        前台服务类型 specialUse —— 不是 dataSync！
        Android 15 起 dataSync 类型 24 小时内累计只能跑 6 小时，超时会抛
        RemoteServiceException，常驻心跳必然触发。specialUse 不在该名单，
        也不在 BOOT_COMPLETED 禁启动名单里。
        另外 dataSync / specialUse 的区别必须保留在注释里，避免以后被"优化"回去。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 常驻通知（不是前台服务的前置条件，仅影响通知可见性） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟（Android 14 起默认拒绝，需引导用户手动开启） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 引导加入电池优化白名单（不加白名单 HyperOS 上难以保活） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 上报期间短持锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".RainyStatusApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RainyStatus"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RainyStatus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            常驻心跳前台服务。
            PROPERTY_SPECIAL_USE_FGS_SUBTYPE 是 specialUse 类型的必需声明（说明具体用途）。
        -->
        <service
            android:name=".service.StatusHeartbeatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Periodic device battery and presence heartbeat to the user's own status dashboard" />
        </service>

    </application>

</manifest>